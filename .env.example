# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Clerk (Authentication)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
SANITY_API_TOKEN=your_sanity_token

# Prisma / Deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (email)
RESEND_API_KEY=rsnd_test_xxx

# UploadThing
UPLOADTHING_SECRET=uploadthing_secret_xxx

# Sentry (error monitoring)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_RATE=0.1

# Other
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Uncomment and set to 'supabase' or 'neon' depending on your provider
# DB_PROVIDER=supabase

# Supabase (for vectors / pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=service_role_key_here
# Optional: name of RPC function to call for similarity search (default: match_vectors)
SUPABASE_MATCH_FUNCTION=match_vectors
